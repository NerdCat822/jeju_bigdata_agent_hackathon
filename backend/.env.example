# 머물멍 백엔드 환경변수 예시 — 이 파일을 .env 로 복사해 값을 채우세요. (.env 는 저장소에 올리지 않아요)

# 데이터 모드: synthetic(샘플) | hub(허브 수집본) | center(센터 추출본)
MEOMUL_DATA_MODE=synthetic

# LLM 모드: template(LLM 없음, 기본) | anthropic(클라우드 Claude, 선택)
MEOMUL_LLM_MODE=template

# 클라우드 LLM (선택) — 인터넷과 API 키가 있을 때만
MEOMUL_ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# 데이터 창고 (PostgreSQL). 비우면 docker-compose.yml 의 db 서비스 기본값을 써요 (127.0.0.1:5434, meomul).
# 따로 설치한 PostgreSQL 을 쓸 때만 채워요. 암호는 이 파일(.env)에만 적고 저장소에 올리지 않아요.
MEOMUL_PG_HOST=
MEOMUL_PG_PORT=
MEOMUL_PG_DB=
MEOMUL_PG_USER=
MEOMUL_PG_PASSWORD=

# 웹 API 서버 (React 화면이 붙는 곳). 기본은 이 PC 안에서만 열려요.
MEOMUL_API_HOST=127.0.0.1
MEOMUL_API_PORT=8501
# 개발할 때 React 개발 서버에서 API를 부를 수 있게 허용할 주소 (쉼표로 구분). 비우면 기본값(5173, 3000 포트)을 써요.
MEOMUL_CORS_ORIGINS=
# 빌드한 React 화면 폴더. 비우면 ../frontend/dist 를 찾아요.
MEOMUL_WEB_DIST=
# 여러 사람이 같은 주소로 쓰는 배포본: 모드를 고정하고(true) API 문서를 닫아요(false). 비우면 바꿀 수 있고 문서도 열려요.
MEOMUL_LOCK_MODES=
MEOMUL_API_DOCS=

# 네이버 클라우드 Maps (선택). 비우면 기본 지도로 그려요. Secret 은 서버에서만 써요.
# Dynamic Map 은 NCP 콘솔 Application 의 Web 서비스 URL 에 등록한 주소에서만 열려요.
NAVER_CLOUD_PLATFORM_CLIENT_ID=
NAVER_CLOUD_PLATFORM_CLIENT_SECRET=
# 인터넷이 없는 센터 PC 처럼 지도를 끄려면 false
MEOMUL_NAVER_MAPS=

# 제주데이터허브 Open API 프로젝트 키 (데이터 수집할 때만 필요)
MEOMUL_HUB_PROJECT_KEY=
